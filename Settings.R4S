# R4OS Kernel path mappings
# WORKSPACE_ROOT and REPOSITORIES_ROOT are relative to this Kernel directory.
# CONTRACT_ROOT is relative to REPOSITORIES_ROOT. DEVKIT_ROOT and
# ARTIFACTS_ROOT are relative to WORKSPACE_ROOT. Do not wrap values in quotes.

WORKSPACE_ROOT=../..
REPOSITORIES_ROOT=..

CONTRACT_ROOT=Contract

DEVKIT_ROOT=DevKit
ARTIFACTS_ROOT=Artifacts
